{
  "name": "home-power-status-monitor",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "husky",
    "test": "cd src && node --import=extensionless/register --import=../tests/unit/setup.js --test ../tests/unit/*.test.js",
    "lint": "eslint . --ext .js,.mjs",
    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "start": "cd src && node --import=extensionless/register app.js",
    "check": "node scripts/check.mjs"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "dotenv-flow": "^4.1.0",
    "extensionless": "^2.0.6",
    "form-data": "^4.0.6",
    "grammy": "^1.44.0",
    "nanoid": "^6.0.0",
    "node-cron": "^4.6.0",
    "p-queue": "^9.3.1",
    "qs": "6.16.0",
    "tunnel": "^0.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.1.0",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5"
  },
  "resolutions": {
    "qs": "6.16.0"
  },
  "extensionless": {
    "lookFor": [
      "js",
      "mjs",
      "cjs"
    ]
  }
}
