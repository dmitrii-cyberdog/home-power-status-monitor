# Select NODE_ENV through PM2 or your shell: local, dev, or prod.
# Private overrides belong in .env.local. Never commit real credentials.

DEFAULT_LOCALE=en

TG_BOT_TOKEN=
TG_BOT_ACCESS_SECRET=

CRON_CHECK_POWER_STATUS_IS_ENABLED=0
POWER_CHECK_INTERVAL_SECONDS=60
POWER_OFF_FAILED_CHECKS=3

# Uncomment a home/device block and fill in its credentials to monitor it.
# Use the exact camera name from the EZVIZ account; serial is optional.
# HOME_1_NAME=Example Home
# HOME_1_EZVIZ_API_APP_KEY=
# HOME_1_EZVIZ_API_SECRET=
# HOME_1_EZVIZ_API_BASE_URL=https://ieuopen.ezvizlife.com
# HOME_1_POWER_OFF_OFFLINE_DEVICE_COUNT=1
# DEVICE_1_HOME_1_TYPE=ezviz
# DEVICE_1_HOME_1_NAME=Example Camera
# DEVICE_1_HOME_1_SERIAL=
