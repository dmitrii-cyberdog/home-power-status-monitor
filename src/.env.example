# Use as a template for src/.env; put private overrides in src/.env.local.
# Set NODE_ENV=production before startup to select src/.env.prod instead of .env.dev.
DEFAULT_LOCALE=en

# Leave empty to disable Telegram polling.
TG_BOT_TOKEN=

# Disabled placeholder: no device checks or notifications are implemented yet.
CRON_CHECK_POWER_STATUS_IS_ENABLED=0
CRON_CHECK_POWER_STATUS_TEMPLATE=* * * * *

